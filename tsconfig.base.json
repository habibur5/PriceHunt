{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pricehunt/shared": ["packages/shared/src/index.ts"],
      "@pricehunt/shared/*": ["packages/shared/src/*"],
      "@pricehunt/core": ["packages/core/src/index.ts"],
      "@pricehunt/core/*": ["packages/core/src/*"],
      "@pricehunt/database": ["packages/database/src/index.ts"],
      "@pricehunt/database/*": ["packages/database/src/*"],
      "@pricehunt/scraper-sdk": ["packages/scraper-sdk/src/index.ts"],
      "@pricehunt/scraper-sdk/*": ["packages/scraper-sdk/src/*"],
      "@pricehunt/notifications": ["packages/notifications/src/index.ts"],
      "@pricehunt/notifications/*": ["packages/notifications/src/*"]
    }
  }
}